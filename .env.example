# Velnest local development environment.
# Copy to .env (git-ignored) and adjust. Never commit real values.
#
# Where real values live:
#   - Vercel project env vars (apps/api): ENV, DATABASE_URL, OTEL_EXPORTER_OTLP_ENDPOINT
#     Set per Vercel environment (staging = custom environment tracking main, production).
#   - GitHub environment secrets: STAGING_DATABASE_MIGRATE_URL (environment "staging")
#   - Supabase dashboard: connection strings for each project (ap-southeast-1)

# --- API runtime (apps/api, cmd/server and cmd/worker) ---------------------

# development | staging | production. Selects the embedded configs/*.yaml.
ENV=development

# HTTP listen port. Optional, defaults to 7979.
PORT=7979

# Runtime connection. Local: the docker compose db service (host port 54322).
# Staging/production: Supabase TRANSACTION pooler (port 6543). The server uses
# the pgx simple protocol, which the transaction pooler requires.
DATABASE_URL=postgres://velnest:velnest@localhost:54322/velnest?sslmode=disable

# OTLP endpoint for traces and metrics. Optional; leave unset to disable.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Migrations (cd apps/api && go run ./cmd/migrate up|down [n]|version) ---

# Local: same database as above.
# Staging/production: Supabase SESSION pooler (port 5432 on the pooler host) or
# a direct connection. NEVER port 6543: migrations need session-level features.
# CI uses the GitHub secret STAGING_DATABASE_MIGRATE_URL for this variable.
DATABASE_MIGRATE_URL=postgres://velnest:velnest@localhost:54322/velnest?sslmode=disable

# --- Integration tests ------------------------------------------------------

# Used by api integration tests. Without it they skip locally; when CI is set
# they fail instead. CI provides its own Postgres service on port 5432.
VELNEST_TEST_DATABASE_URL=postgres://velnest:velnest@localhost:54322/velnest?sslmode=disable
