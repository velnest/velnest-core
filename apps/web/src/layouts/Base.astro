---
import '../styles/tokens.css';
import '../styles/global.css';
import { locales, t, type Locale } from '../i18n/t';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
// Absolute hreflang URLs need `site` in astro.config.mjs (production domain not decided yet);
// until then fall back to root-relative paths instead of leaking a localhost origin.
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const title = t(locale, 'meta.title');
const description = t(locale, 'meta.description');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      locales.map((l) => (
        <link rel="alternate" hreflang={l} href={abs(`/${l}/`)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={abs('/id/')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
